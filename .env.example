STORY_STORAGE=sqlite
# Persistent UTC daily paid freeform attempt cap across Shared Adventure AND
# My Story personal journeys, in the same DB bucket (1–10000).
# Failed/abandoned calls count. Safe finite default is 100.
MUSE_ADVENTURE_DAILY_ACTION_CAP=100
# All paid AI requests, including classic generation/continuations and enabled
# ElevenLabs narration: hard UTC daily cap (1-100), warning at 80%.
MUSE_AI_DAILY_ATTEMPT_CAP=100
# Set true and drain in-flight requests/uploads before a consistent full backup.
MUSE_MAINTENANCE_MODE=false
# Public beta stays blocked while operator/contact/recovery review is incomplete.
NEXT_PUBLIC_MUSE_OPERATOR_NAME=
NEXT_PUBLIC_MUSE_SUPPORT_EMAIL=
# Set only after independently checking an encrypted backup and restore rehearsal.
# MUSE_BACKUP_LAST_VERIFIED_AT=2026-10-14T00:00:00Z
# Hosted creation/personal requests: set a private random code (16-512 characters).
# MUSE_CREATOR_ACCESS_CODE=your-private-random-code
# NEXT_PUBLIC_MUSE_CREATOR_LOCKED=true
# Local SQLite uses Node.js 24 LTS; no database account is required.
# Optional: MUSE_SQLITE_PATH=data/muse-stories.sqlite
# Optional: MUSE_MEDIA_PATH=data/shared-media (private Shared Story photos/videos; never inside public/)
# Hosted Vercel use requires STORY_STORAGE=supabase and the values below.
# Apply shared-stories.sql, shared-adventures.sql, then personal-journeys.sql
# explicitly in that order before enabling journeys. Application does not apply SQL.
# Photos/videos also require shared-story-media.sql and its private storage bucket.
# Operational controls and private personal deletion require operations.sql.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=anon-key
SUPABASE_SERVICE_ROLE_KEY=service-role-key

LLM_PROVIDER=ANTHROPIC
ANTHROPIC_API_KEY=your-anthropic-api-key
LLM_MODEL=claude-haiku-5-5
# Optional alternative: LLM_PROVIDER=OPENAI, OPENAI_API_KEY=<OpenAI key>,
# LLM_MODEL=gpt-4.1-mini
# Optional alternative: LLM_PROVIDER=GROQ, LLM_API_KEY=<Groq key>,
# LLM_MODEL=llama-3.3-70b-versatile

ELEVEN_API_KEY=your-eleven-api-key
ELEVEN_VOICE_ID=alloy
NEXT_PUBLIC_NARRATION_PROVIDER=browser
# Browser mode uses installed speech voices and makes no ElevenLabs requests.
# Set to elevenlabs only after privately configuring a valid provider key/voice.

STRIPE_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

NEXT_PUBLIC_APP_NAME=Muse
